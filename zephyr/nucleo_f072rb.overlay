/*
 * nucleo-f072rb: mecanum drive + gripper + hopper + arm bus
 *
 *   pwm (speed)                     dir
 *   PA0  TIM2_CH1  front-left       PC0  front-left
 *   PA1  TIM2_CH2  front-right      PC1  front-right
 *   PB0  TIM3_CH3  back-left        PC2  back-left
 *   PB1  TIM3_CH4  back-right       PC3  back-right
 *   PA8  TIM1_CH1  gripper servo
 *   PB8/PB9        hopper dir (TB6612FNG ain1/ain2)
 *   PB10/PB11      usart3 -> arm servo bus
 *
 * note: f0 has no TIM4 and PB7 has no normal pwm channel, so back-right is on
 * PB1/TIM3_CH4 (not PB7) — different from the L476/G474 versions.
 * 48 MHz core, prescaler 0 = full timer clock (20 kHz pwm = ~2400 counts).
 * board leaves these timers disabled/unlabeled, so they're set up here.
 */

#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

&timers2 {
	st,prescaler = <0>;
	status = "okay";

	pwm2: pwm {
		status = "okay";
		pinctrl-0 = <&tim2_ch1_pa0 &tim2_ch2_pa1>;   // PA0 FL, PA1 FR
		pinctrl-names = "default";
	};
};

&timers3 {
	st,prescaler = <0>;
	status = "okay";

	pwm3: pwm {
		status = "okay";
		pinctrl-0 = <&tim3_ch3_pb0 &tim3_ch4_pb1>;   // PB0 RL, PB1 RR
		pinctrl-names = "default";
	};
};

&timers1 {
	// 16-bit timer. /48 -> 1 MHz tick, so a 20 ms servo frame = 20000 counts
	st,prescaler = <47>;
	status = "okay";

	pwm1: pwm {
		status = "okay";
		pinctrl-0 = <&tim1_ch1_pa8>;                 // PA8 gripper
		pinctrl-names = "default";
	};
};

&usart3 {
	// arm servo bus. PB10 tx / PB11 rx tied together (1k on tx) for half-duplex
	pinctrl-0 = <&usart3_tx_pb10 &usart3_rx_pb11>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/ {
	motors: motors {
		compatible = "capstone,mecanum-motors";
		// FL, FR, RL, RR
		pwms = <&pwm2 1 PWM_USEC(50) PWM_POLARITY_NORMAL>,
		       <&pwm2 2 PWM_USEC(50) PWM_POLARITY_NORMAL>,
		       <&pwm3 3 PWM_USEC(50) PWM_POLARITY_NORMAL>,
		       <&pwm3 4 PWM_USEC(50) PWM_POLARITY_NORMAL>;

		dir-gpios = <&gpioc 0 GPIO_ACTIVE_HIGH>,
			    <&gpioc 1 GPIO_ACTIVE_HIGH>,
			    <&gpioc 2 GPIO_ACTIVE_HIGH>,
			    <&gpioc 3 GPIO_ACTIVE_HIGH>;
	};

	gripper: gripper {
		compatible = "capstone,gripper";
		pwms = <&pwm1 1 PWM_USEC(20000) PWM_POLARITY_NORMAL>;   // 50 Hz frame
	};

	hopper: hopper {
		compatible = "capstone,hopper";
		// TB6612FNG channel A (PWMA + STBY tied high)
		ain1-gpios = <&gpiob 8 GPIO_ACTIVE_HIGH>;
		ain2-gpios = <&gpiob 9 GPIO_ACTIVE_HIGH>;
	};
};
